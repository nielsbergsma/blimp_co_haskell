cabal-version:      3.0
name:               backoffice
version:            0.1.0.0
category:           Web
build-type:         Simple

flag interactive
  default:
    False
  manual:
    True

common warnings
  ghc-options:
    -funbox-strict-fields -O2 -ferror-spans -fspecialise-aggressively -Wall

common options
  if arch(wasm32)
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM
    if flag (interactive)
      cpp-options:
        -DINTERACTIVE

  if arch(javascript)
     ld-options:
       -sEXPORTED_RUNTIME_METHODS=HEAP8

executable app
  import:
    options, warnings
  main-is:
    Application.hs
  other-modules:
    Components.Icon
    Components.Header
    Components.Popover
    Components.SignInModal
    Components.FlightCalendar
    Data.FlightScheduling 
    Extensions.Time
    Pages.Reservations
    Pages.NotFound
    Pages.FlightScheduling
    Configuration
    Session
    Routes
  build-depends: 
    base < 5, 
    miso >= 1.9, 
    text, 
    time, 
    containers, 
    geohash,
    hashable
  hs-source-dirs:
    src
  default-extensions:
    CPP
    OverloadedStrings
    OverloadedRecordDot
    DuplicateRecordFields
    RecordWildCards
    LambdaCase
    ImportQualifiedPost
    FlexibleContexts
    NamedFieldPuns
    DeriveGeneric
    DeriveAnyClass
  default-language:
    Haskell2010
